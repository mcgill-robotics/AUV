// Level 1 and 2: who is in the picture, and the big boxes inside each system.
// Components (level 3) live in their own files and use `extend`.

model {
  operator = actor 'Operator' {
    summary 'Drives with an Xbox controller, watches in Foxglove.'
  }

  hw = device 'AUV Hardware' {
    summary 'The physical devices. Each reaches the software through its own path.'
  }
  zed = external 'ZED SDK' {
    summary 'Stereo depth, visual odometry, capture. The sim feeds it a fake camera.'
  }
  roboflow = external 'Roboflow' {
    summary 'Where real images get their labels corrected by hand.'
  }

  // ------------------------------------------------------------------
  auv = system 'AUV Software' {
    summary 'The ROS 2 stack. Runs on the Jetson, or in the dev container next to the sim.'

    bringup = app 'bringup' {
      link https://github.com/mcgill-robotics/AUV/blob/main/ros2_ws/src/bringup/launch/bringup.launch.py 'bringup.launch.py'
      summary 'One launch file, no nodes. Includes every other package.'
      description '
        Starts sensors, propulsion, controls, vision, telemetry and (optionally) the planner.
        sim:=true skips the hardware drivers and adds ros_tcp_endpoint.
        planner defaults to off. dvl is forced on here, but off by default in sensors,
        because the DVL can overheat out of the water.
      '
    }
    drivers = app 'Hardware drivers' {
      #real
      summary 'Xsens IMU driver, DVL serial driver, micro-ROS agents.'
      description 'Not started in sim. Serial devices get stable names from udev rules (/dev/display, /dev/actuator, /dev/power).'
    }
    tcp = app 'ros_tcp_endpoint' {
      #sim
      link https://github.com/Unity-Technologies/ROS-TCP-Endpoint 'ROS-TCP-Endpoint'
      summary 'TCP bridge to Unity, port 10000.'
    }
    sensors = app 'sensors' {
      link https://github.com/mcgill-robotics/AUV/tree/main/ros2_ws/src/sensors 'ros2_ws/src/sensors'
      summary 'Raw sensors in, one fused pose out.'
      description '''
        Every sensor is converted into the AUV frame once, then fused into `state/pose`.

        ![The two frames: pool_link is fixed, auv_link moves with the vehicle](img/frames.svg)
      '''
    }
    controls = app 'controls' {
      link https://github.com/mcgill-robotics/AUV/tree/main/ros2_ws/src/controls 'ros2_ws/src/controls'
      summary 'A goal in, one total wrench out. The controllers start disabled; the planner turns them on.'
    }
    propulsion = app 'propulsion' {
      link https://github.com/mcgill-robotics/AUV/tree/main/ros2_ws/src/propulsion 'ros2_ws/src/propulsion'
      summary 'Wrench to eight thruster forces to PWM.'
    }
    teleop = app 'teleop' {
      link https://github.com/mcgill-robotics/AUV/tree/main/ros2_ws/src/teleop 'ros2_ws/src/teleop'
      summary 'Gamepad or keyboard to wrench.'
    }
    planner = app 'planner' {
      link https://github.com/mcgill-robotics/AUV/tree/main/ros2_ws/src/planner 'ros2_ws/src/planner'
      summary 'Behaviour tree that runs the competition tasks.'
    }
    vision = app 'vision' {
      link https://github.com/mcgill-robotics/AUV/tree/main/ros2_ws/src/vision 'ros2_ws/src/vision'
      summary 'Camera images in, a persistent 3D map of the course out.'
    }
    telemetry = app 'telemetry' {
      link https://github.com/mcgill-robotics/AUV/tree/main/ros2_ws/src/telemetry 'ros2_ws/src/telemetry'
      summary 'Foxglove bridge, scene markers, rosbag recording.'
    }
    models = store 'Model packages' {
      summary 'One folder per model: ONNX weights, TensorRT engine (engine.plan), class names, configs.'
    }
    bags = store 'Rosbags' {
      summary 'Recordings in ~/AUV/rosbags.'
    }
  }

  // ------------------------------------------------------------------
  sim = system 'Unity Simulator' {
    summary 'Unity HDRP sim of the vehicle, pool and competition. Also makes synthetic training images.'

    reset = app 'Sim core' {
      summary 'ROS settings, clock, reset, camera render manager.'
      description 'ROSSettings holds every topic name and frame id. SimulationResetManager listens on /simulation/reset (std_msgs/Bool).'
    }
    physics = app 'Vehicle physics' {
      summary 'Buoyancy, drag, thrusters.'
    }
    simsensors = app 'Sensor simulation' {
      summary 'DVL, IMU, depth, ground truth, with noise.'
    }
    camera = app 'Camera rendering' {
      summary 'Renders the cameras and bends the image like a flat port.'
    }
    scoring = app 'Competition scoring' {
      summary 'Task triggers, points, timer. Never touches ROS.'
    }
    synth = app 'Synthetic data generator' {
      summary 'Randomizes scene, water and camera, labels every frame.'
    }
    converter = app 'YOLO Converter' {
      summary 'Editor tool. SOLO output to YOLO images and labels.'
    }
    solo = store 'SOLO dataset' {
      summary 'Raw Perception output.'
    }
  }

  // ------------------------------------------------------------------
  training = system 'Training Pipeline' {
    summary 'Labelled images in, a TensorRT detector out. Lives in vision/model_pipeline.'

    datasets = store 'Datasets' {
      summary 'Raw imports and the train/val/test splits.'
    }
    organize = app 'organize_dataset' {
      link https://github.com/mcgill-robotics/AUV/blob/main/ros2_ws/src/vision/model_pipeline/organize_dataset.py 'organize_dataset.py'
      summary 'Splits 70/20/10. YOLO or COCO. Optional letterbox to 512.'
    }
    augment = app 'augment_dataset' {
      link https://github.com/mcgill-robotics/AUV/blob/main/ros2_ws/src/vision/model_pipeline/augment_dataset.py 'augment_dataset.py'
      summary 'Albumentations on the train split only. Synthetic data only.'
    }
    train = app 'training' {
      link https://github.com/mcgill-robotics/AUV/blob/main/ros2_ws/src/vision/model_pipeline/training.py 'training.py'
      summary 'YOLO or RF-DETR. Can fine-tune from a checkpoint.'
    }
    export = app 'export and engine build' {
      link https://github.com/mcgill-robotics/AUV/blob/main/ros2_ws/src/vision/models/export_rfdetr.py 'export_rfdetr.py'
      summary 'ONNX export, then trtexec on the Jetson.'
    }
    prelabel = app 'Pre-labelling tools' {
      summary 'Runs the synthetic model on real images so people only fix labels.'
    }
  }
}
