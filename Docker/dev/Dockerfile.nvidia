# ---------------------------------------------------------
# Build Arguments
# ---------------------------------------------------------
ARG CUDA_MAJOR=13
ARG CUDA_MINOR=0
ARG CUDA_PATCH=0
ARG UBUNTU_RELEASE=24

# ---------------------------------------------------------
# Base Image: We use our own custom compiled openCV base image
# ---------------------------------------------------------
FROM mcgillrobotics/auv_2026:dev-opencv-base

# Get uv
COPY --from=ghcr.io/astral-sh/uv:0.11.9 /uv /uvx /bin/
ENV UV_SYSTEM_PYTHON=1

# Standard CUDA paths used at runtime
ENV CUDA_ROOT=/usr/local/cuda
ENV PATH=${CUDA_ROOT}/bin:${PATH}
ENV CUDA_INC_DIR=${CUDA_ROOT}/include
ENV LD_LIBRARY_PATH=${CUDA_ROOT}/lib64:${LD_LIBRARY_PATH}

# all arguments after pulling from base image are flushed, so we re-declare them
ARG ZED_SDK_MAJOR=5
ARG ZED_SDK_MINOR=4
ARG ZED_SDK_PATCH=0 
ARG CUDA_MAJOR=13
ARG CUDA_MINOR=0
ARG UBUNTU_RELEASE=24
ARG UBUNTU_MINOR_RELEASE=04

# Set environment variables
ENV LANG=C.UTF-8 \
        LC_ALL=C.UTF-8 \
        DEBIAN_FRONTEND=noninteractive \
        ROS_DISTRO=jazzy \
        # Critical for ZED SDK to access hardware
        NVIDIA_DRIVER_CAPABILITIES=all \
        TZ=Americas/Montreal \
        IS_JETSON=false

# ---------------------------------------------------------
# 1. Install System Dependencies & ROS 2 Setup
# ---------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        git-lfs \
        curl \
        wget \
        gnupg2 \
        lsb-release \
        ca-certificates \
        sudo \
        vim \
        # Python
        python3-pip \
        python3-dev \
        python3-setuptools \
        python3-opencv \
        # Networking/Utils
        iputils-ping \
        nano \
        tmux \
        usbutils \
        v4l-utils \
        # GUI Support (RQT/Rviz)
        libgl1 \
        libglx-mesa0 \
        libgl1-mesa-dri \
        && rm -rf /var/lib/apt/lists/*

# Add ROS 2 Jazzy Repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null
# Note that the CI does not have access to NVIDIA hardware, so we manually install the stubs only on CI to satisfy the linker when building ZED dependent packages
ARG CI
RUN if [ "$CI" = "true" ]; then \
        echo "Installing ZED stubs for CI"; \
        # Install NVIDIA driver stubs (allows linker to find CUDA symbols when building ZED dependent packages, even though we won't actually be able to run them in CI). There is a third package 'libcuda.so' but it these two depend on libcuda and so apt installs it for us
        apt-get update && apt-get install -y \
        libnvidia-decode-550 \
        libnvidia-encode-550 && \
        rm -rf /var/lib/apt/lists/* && \
        apt-get clean; \
        else \
        echo "Building container locally"; \
        fi
# set it as env var so build scripts can see it
ENV CI=${CI}
# Install ROS 2 Desktop (Includes Rviz, RQT, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-desktop \
        ros-${ROS_DISTRO}-ros-base \
        # Bridge & Teleop
        ros-${ROS_DISTRO}-foxglove-bridge \
        ros-${ROS_DISTRO}-foxglove-msgs \
        ros-${ROS_DISTRO}-joy \
        ros-${ROS_DISTRO}-joy-teleop \
        ros-${ROS_DISTRO}-backward-ros \
        # Image & PointCloud Transport
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-image-transport-plugins \
        ros-${ROS_DISTRO}-compressed-image-transport \
        ros-${ROS_DISTRO}-point-cloud-transport \
        ros-${ROS_DISTRO}-point-cloud-transport-plugins \
        # Navigation & Localization
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-nmea-msgs \
        ros-${ROS_DISTRO}-mavros \
        ros-${ROS_DISTRO}-mavros-msgs \
        ros-${ROS_DISTRO}-marine-sensor-msgs \
        ros-${ROS_DISTRO}-vision-msgs \
        ros-${ROS_DISTRO}-tf-transformations \
        # Visualization Tools
        ros-${ROS_DISTRO}-rqt-image-view \
        ros-${ROS_DISTRO}-rqt-graph \
        # Robot Description & Drivers
        ros-${ROS_DISTRO}-xacro \
        ros-${ROS_DISTRO}-robot-state-publisher \
        ros-${ROS_DISTRO}-diagnostic-updater \
        ros-${ROS_DISTRO}-usb-cam \
        ros-${ROS_DISTRO}-zed-msgs \
        ros-${ROS_DISTRO}-rosbag2-storage-mcap \
        # Planner packages
        ros-${ROS_DISTRO}-py-trees \
        ros-${ROS_DISTRO}-py-trees-ros-interfaces \
        ros-${ROS_DISTRO}-py-trees-ros \
        ros-${ROS_DISTRO}-py-trees-ros-tutorials \
        ros-${ROS_DISTRO}-py-trees-ros-viewer \
        # Build Tools
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
        && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------
# 2. Install micro-ROS Agent (for microcontroller communication)
# ------------------------------------------
WORKDIR /opt/ros/micro_ros_ws
RUN git clone -b ${ROS_DISTRO} https://github.com/micro-ROS/micro_ros_setup.git src/micro_ros_setup

RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
        colcon build \
                --parallel-workers $(nproc) \
                --merge-install \
                --event-handlers console_direct+ \
                --base-paths src \
                --cmake-args -DCMAKE_BUILD_TYPE=Release && \
        . /opt/ros/micro_ros_ws/install/setup.sh && \
        MICROROS_PREFIX=$(ros2 pkg prefix micro_ros_setup) && \
        ros2 run micro_ros_setup create_ws.sh src "$MICROROS_PREFIX/config/agent_ros2_packages.txt" "$MICROROS_PREFIX/config/agent_uros_packages.repos" && \
        colcon build \
                --packages-up-to micro_ros_agent $@ \
                --parallel-workers $(nproc) \
                --merge-install \
                --event-handlers console_direct+ \
                --cmake-args \
                        "-DUAGENT_BUILD_EXECUTABLE=OFF" \
                        "-DUAGENT_P2P_PROFILE=OFF" \
                        "--no-warn-unused-cli" && \
        rm -rf build log

# ----------------------------------------------------------
# 3. Set user and groups to match the host with fixuid
# ----------------------------------------------------------
ARG USERNAME=douglas
ARG USER_UID=1000
ARG USER_GID=$USER_UID

# 1. Create or rename the group
RUN if getent group $USER_GID; then \
        groupmod -n $USERNAME $(getent group $USER_GID | cut -d: -f1); \
        else \
        groupadd --gid $USER_GID $USERNAME; \
        fi && \
        if getent passwd $USER_UID; then \
        usermod -l $USERNAME -m -d /home/$USERNAME $(getent passwd $USER_UID | cut -d: -f1); \
        else \
        useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME; \
        fi && \
        # 2. Create the user
        echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
        && chmod 0440 /etc/sudoers.d/$USERNAME \
        && usermod -aG video,render,dialout -s /bin/bash $USERNAME

# Install fixuid for dynamic UID/GID remapping at runtime
ARG FIXUID_VERSION=0.6.0
RUN ARCH="$(dpkg --print-architecture)" && \
        curl -fsSL "https://github.com/boxboat/fixuid/releases/download/v${FIXUID_VERSION}/fixuid-${FIXUID_VERSION}-linux-${ARCH}.tar.gz" | tar -C /usr/local/bin -xzf - && \
        chown root:root /usr/local/bin/fixuid && \
        chmod 4755 /usr/local/bin/fixuid && \
        mkdir -p /etc/fixuid && \
        printf "user: $USERNAME\ngroup: $USERNAME\n" > /etc/fixuid/config.yml


# ----------------------------------------------------------
# 4. Entrypoint and Environment Setup
# ----------------------------------------------------------
# Copy entrypoint
COPY Docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Switch to the User and configure the environment
USER $USERNAME

# set colcon home after adding user
ENV COLCON_HOME=/home/$USERNAME/.colcon
# move repo defaults.yaml to container
COPY .colcon ${COLCON_HOME}/

WORKDIR /home/$USERNAME/AUV
# Add source commands to bashrc
RUN echo "source /opt/ros/${ROS_DISTRO}/local_setup.bash && source /opt/ros/micro_ros_ws/install/local_setup.bash" >> ~/.bashrc && \
        echo "if [ -f ~/AUV/ros2_ws/install/setup.bash ]; then source ~/AUV/ros2_ws/install/setup.bash; fi" >> ~/.bashrc

# Entrypoint uses fixuid to remap UID/GID if running with --user
ENTRYPOINT ["entrypoint.sh"]

# Keep container alive
CMD ["bash"]
