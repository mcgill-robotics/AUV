# Stage 1: Base Image (Dockerfile.base)
# =============================================================================
# Build once, push to registry, treat as immutable artifact.
# Only rebuild intentionally when upgrading a dependency.
#
# Personal AUV layer over the locally built official Isaac ROS base.
# =============================================================================
ARG BASE_IMAGE=mcgillrobotics/isaac-ros-base:r39.2
FROM ${BASE_IMAGE}

# ---- uv package manager ----
COPY --from=ghcr.io/astral-sh/uv:0.11.9 /uv /uvx /bin/

# ---- Build arguments ----
ARG OPENCV_VERSION=4.14.0
ARG JETSON_PIP_INDEX=https://pypi.jetson-ai-lab.io/sbsa/cu130
ARG ZED_SDK_MAJOR=5
ARG ZED_SDK_MINOR=4
ARG ZED_SDK_PATCH=1
ARG ZED_PYTHON_REF=r5.4
ARG L4T_MAJOR=39
ARG L4T_MINOR=2
ARG UBUNTU_RELEASE=24
ARG UBUNTU_MINOR_RELEASE=04

# ---- AUV build environment ----
ENV UV_SYSTEM_PYTHON=1 \
    CUDA_ROOT=/usr/local/cuda \
    CUDA_INC_DIR=/usr/local/cuda/include \
    ZED_SDK_URL="https://download.stereolabs.com/zedsdk/${ZED_SDK_MAJOR}.${ZED_SDK_MINOR}.${ZED_SDK_PATCH}/l4t${L4T_MAJOR}.${L4T_MINOR}/jetsons"

WORKDIR /root

RUN apt-get update && apt-get install -y --no-install-recommends \
    cuda-toolkit-13-2 \
    libcudnn9-cuda-13 \
    libcudss0-cuda-13 \
    libnvpl-blas0 \
    libnvpl-lapack0 \
    tensorrt-libs \
    tensorrt-dev \
    libnvinfer-bin \
    python3-libnvinfer \
    python3-libnvinfer-dev \
    kmod \
    libboost-all-dev \
    python3-dev \
    zstd \
    && echo "/usr/lib/aarch64-linux-gnu/libcudss/13" > /etc/ld.so.conf.d/cudss.conf \
    && ln -sf /usr/src/tensorrt/bin/trtexec /usr/local/bin/trtexec \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

# =============================================================================
# 4. OpenCV CUDA Source Compilation + python_loader Wheel
# =============================================================================
# Compiles C++ headers/libs AND Python bindings from the same source tree.
# The python_loader wheel registers proper pip metadata so downstream
# ML frameworks see OpenCV as satisfied and don't overwrite it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gfortran \
    libatlas-base-dev \
    libavcodec-dev \
    libavformat-dev \
    libgtk-3-dev \
    libjpeg-dev \
    libpng-dev \
    libswscale-dev \
    libtiff-dev \
    libv4l-dev \
    python3-dev \
    python3-numpy

RUN git clone --depth 1 --branch ${OPENCV_VERSION} https://github.com/opencv/opencv.git /tmp/opencv && \
        git clone --depth 1 --branch ${OPENCV_VERSION} https://github.com/opencv/opencv_contrib.git /tmp/opencv_contrib && \
        mkdir /tmp/opencv/build && cd /tmp/opencv/build && \
        cmake -D CMAKE_BUILD_TYPE=Release \
          -D CMAKE_INSTALL_PREFIX=/usr/local \
          -D OPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules \
          -D WITH_CUDA=ON \
          -D CUDA_ARCH_BIN=8.7 \
          -D CUDA_NVCC_FLAGS="-std=c++17" \
          -D CUDA_CUDA_LIBRARY=/usr/local/cuda/lib64/stubs/libcuda.so \
          -D CMAKE_CXX_STANDARD=17 \
          -D WITH_CUDNN=OFF \
          -D OPENCV_DNN_CUDA=OFF \
          -D ENABLE_FAST_MATH=ON \
          -D CUDA_FAST_MATH=ON \
          -D BUILD_opencv_python3=ON \
          -D OPENCV_PYTHON3_INSTALL_PATH=lib/python3.12/dist-packages \
          -D PYTHON3_EXECUTABLE=$(which python3) \
          -D BUILD_JAVA=OFF \
          -D BUILD_opencv_java=OFF \
          -D BUILD_TESTS=OFF \
          -D BUILD_EXAMPLES=OFF \
          -D BUILD_opencv_sfm=OFF \
          -D OPENCV_GENERATE_PKGCONFIG=ON \
          .. && \
    make -j$(nproc) && \
    make install && ldconfig

    # OpenCV Metadata Mocks (prevents downstream frameworks from overwriting our custom OpenCV)
RUN for pkg in "opencv-python" "opencv-contrib-python" "opencv-python-headless"; do \
        TMP_DIR=$(mktemp -d) && \
        echo "from setuptools import setup; setup(name='$pkg', version='${OPENCV_VERSION}', packages=[])" > "$TMP_DIR/setup.py" && \
        uv pip install "$TMP_DIR" --break-system-packages && \
        rm -rf "$TMP_DIR"; \
    done && \
    rm -rf /tmp/opencv /tmp/opencv_contrib && \
    rm -rf /var/lib/apt/lists/*

# Freeze specific OpenCV packages against APT overwrites
# Narrow hold to exact conflicting packages (avoid broad '*opencv*' wildcard)
# Note: These package names (specifically 'libopencv-core4.5d' and 'libopencv-imgproc4.5d')
# correspond to the default OpenCV versions in the base Ubuntu 22.04 (Jammy) OS distribution.
# If upgrading the underlying Ubuntu release of the base image (e.g. to Ubuntu 24.04 Noble),
# these held package names will need to be updated to match the new default package names in APT.
RUN apt-mark hold \
    libopencv-core-dev libopencv-core4.5d \
    libopencv-imgproc-dev libopencv-imgproc4.5d \
    libopencv-dev \
    python3-opencv 2>/dev/null || true

# =============================================================================
# 5. CV Bridge (vision_opencv) source build against custom CUDA OpenCV
# =============================================================================
# Building cv_bridge from source ensures it links against our custom 
# CUDA-accelerated OpenCV 4.10.0 instead of the CPU-only APT version.
WORKDIR /opt/ros/vision_opencv_ws
RUN git clone --depth 1 --branch rolling https://github.com/ros-perception/vision_opencv.git src/vision_opencv && \
    . /opt/ros/jazzy/setup.sh && \
    colcon build --packages-select cv_bridge image_geometry \
    --merge-install \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DOpenCV_DIR=/usr/lib/aarch64-linux-gnu/cmake/opencv4 && \
    rm -rf build log src

# get constraints
COPY Docker/jetson/constraints.txt /tmp/

# =============================================================================
# 6. PyTorch (no version pins - Jetson AI Lab index prunes old versions)
# =============================================================================
# Install torch ecosystem from Jetson AI Lab with standard PyPI as fallback.
# After pushing this image, upstream wheel removal doesn't affect us.
RUN uv pip install --no-cache \
    --system \
    --break-system-packages \
    --reinstall \
    --index-url ${JETSON_PIP_INDEX} \
    -c /tmp/constraints.txt \
    torch torchvision torchaudio

# =============================================================================
# 7. ZED SDK + Python API
# =============================================================================
# Verify ZED SDK URL exists
ENV ZED_SDK_URL="https://download.stereolabs.com/zedsdk/${ZED_SDK_MAJOR}.${ZED_SDK_MINOR}.${ZED_SDK_PATCH}/l4t${L4T_MAJOR}.${L4T_MINOR}/jetsons"

RUN if [ "$(curl -L -I "${ZED_SDK_URL}" -o /dev/null -s -w '%{http_code}\n' | head -n 1)" = "200" ]; then \
        echo "ZED SDK URL is valid."; \
    else \
        echo "ZED SDK URL does not exist: ${ZED_SDK_URL}"; \
        exit 1; \
    fi

RUN cd /tmp && \
    wget -q --no-check-certificate -O ZED_SDK_installer.run ${ZED_SDK_URL} && \
    chmod +x ZED_SDK_installer.run && \
    ./ZED_SDK_installer.run silent skip_python skip_cuda && \
    chmod -R a+rX /usr/local/zed && \
    ldconfig && \
    rm -rf ZED_SDK_installer.run

# Install ZED Python API with --no-deps to prevent NumPy override.
RUN export PIP_INDEX_URL="https://pypi.python.org/simple" && \
    uv pip install --no-cache --break-system-packages Cython protobuf wheel && \
    git clone -b ${ZED_PYTHON_REF} \
        https://github.com/stereolabs/zed-python-api.git /tmp/zed-python-api && \
    uv pip install -v --break-system-packages --no-deps --no-build-isolation /tmp/zed-python-api/src && \
    rm -rf /tmp/zed-python-api

WORKDIR /root
